{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "extensions/retrieval-autopilot.ts",
    "extensions/retrieval-meta-operator.ts",
    "extensions/retrieval-phase.ts"
  ]
}
